# ==============================================================================
# MVJ College of Engineering — Spotlight Attendance System
# Unified Environment Configuration Template
# Copy to .env for local runtime or configure in deployment platform secrets
# ==============================================================================

# Server Configuration
PORT=3001
NODE_ENV=production
HOST_PORT=3001

# Primary Administrator Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_secure_admin_password_here

# Security Secrets
JWT_SECRET=your_strong_jwt_signing_secret_min_32_characters
REGISTRATION_KEY=STATIC_REG_QR_KEY_SECRET_7890

# Local Storage / Database Path
DB_PATH=/app/data/attendance.db

# Neon Cloud Postgres Integration (Optional / Cloud Sync)
# Obtain from Neon Console: https://console.neon.tech
DATABASE_URL=postgresql://user:password@ep-nameless-mountain-az2j1d5a.c-3.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:password@ep-nameless-mountain-az2j1d5a.c-3.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
NEON_BRANCH=production

# Neon Object Storage / S3 Export Archival (Optional)
# AWS_ACCESS_KEY_ID=your_neon_storage_access_key
# AWS_SECRET_ACCESS_KEY=your_neon_storage_secret_key
# AWS_ENDPOINT_URL_S3=https://br-red-fog-azcp3152.storage.c-3.ap-southeast-1.aws.neon.tech
# AWS_REGION=ap-southeast-1
# NEON_BUCKET_NAME=assets
